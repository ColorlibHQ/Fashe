<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    {%- assign gift_card_value = gift_card.initial_value | money -%}
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card_value, shop: shop.name }}</title>
    <style>{% render 'theme-styles' %}</style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="section" style="display: grid; place-items: center; min-height: 100vh;">
      <div class="page-width" style="max-width: 30rem; text-align: center;">
        <h1 class="h3">{{ shop.name }}</h1>
        <p class="eyebrow">{{ 'gift_cards.issued.subtext' | t }}</p>
        <p class="h1">{{ gift_card.balance | money }}</p>

        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="badge badge--sold-out">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign gift_card_expiry = gift_card.expires_on | date: format: 'date' -%}
          <p class="text-sm">{{ 'gift_cards.issued.expiration_date' | t: expires_on: gift_card_expiry }}</p>
        {%- endif -%}

        <p class="field__label">{{ 'gift_cards.issued.gift_card_code' | t }}</p>
        <p class="h4" style="letter-spacing: 0.1em;">{{ gift_card.code | format_code }}</p>

        <p class="text-sm" style="opacity: 0.7;">
          {%- assign gift_card_balance = gift_card.balance | money -%}
          {{ 'gift_cards.issued.remaining_html' | t: balance: gift_card_balance }}
        </p>

        <div class="button-group" style="justify-content: center; margin-top: var(--space-lg);">
          <a href="{{ shop.url }}" class="button">{{ 'gift_cards.issued.shop_link' | t }}</a>
          <button type="button" class="button button--outline" onclick="window.print()">
            {{ 'gift_cards.issued.print_gift_card' | t }}
          </button>
        </div>
      </div>
    </main>
  </body>
</html>
