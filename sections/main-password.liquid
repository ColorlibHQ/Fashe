<section class="section color-{{ section.settings.color_scheme }} color-scheme" style="min-height: 100vh; display: grid; place-items: center;">
  <div class="page-width" style="max-width: 34rem; text-align: center;">
    <h1 class="h1">{{ shop.name }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- endif -%}

    <div style="margin-top: var(--space-lg);">
      {% render 'newsletter-form', id: 'PasswordNewsletter' %}
    </div>

    <details style="margin-top: var(--space-xl);">
      <summary class="button--link">{{ 'general.password_page.login_form_heading' | t }}</summary>
      <div style="margin-top: 1rem;">
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <p class="form__message form__message--error">{{ 'general.password_page.login_form_error' | t }}</p>
          {%- endif -%}
          <div class="field">
            <label class="field__label" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
            <input type="password" id="Password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
          </div>
          <button type="submit" class="button" style="margin-top: 1rem;">{{ 'general.password_page.login_form_submit' | t }}</button>
        {%- endform -%}
      </div>
    </details>

    <p class="text-xs" style="margin-top: var(--space-lg); opacity: 0.6;">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme_1"
    }
  ]
}
{% endschema %}
