{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign recommendations_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: products_to_show
-%}

<product-recommendations data-url="{{ recommendations_url }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section color-{{ section.settings.color_scheme }} color-scheme">
      <div class="page-width">
        <div class="section-header">
          <div class="section-header__text">
            <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
          </div>
        </div>

        <div class="grid grid--products" style="--columns: {{ section.settings.columns }}; --columns-mobile: 2;">
          {%- for recommendation in recommendations.products -%}
            <div data-animate>
              {% render 'product-card', product: recommendation, sizes: '(min-width: 990px) 25vw, 50vw' %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h3"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme_1"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
