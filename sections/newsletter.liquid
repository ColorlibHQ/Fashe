<section class="section color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width" style="max-width: 40rem; text-align: center;" data-animate>
    {%- if section.settings.heading != blank -%}
      <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    <div style="margin-top: 1.5rem;">
      {%- assign newsletter_id = 'Newsletter-' | append: section.id -%}
      {% render 'newsletter-form', id: newsletter_id %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Join the list"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.newsletter.settings.heading_size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.newsletter.settings.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.newsletter.settings.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.newsletter.settings.heading_size.options__3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "<p>Be first to know about new arrivals and offers.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.newsletter.settings.color_scheme.label",
      "default": "scheme_2"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.preset__1.name"
    }
  ]
}
{% endschema %}
