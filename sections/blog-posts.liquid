{%- assign blog = section.settings.blog -%}
<section class="section color-{{ section.settings.color_scheme }} color-scheme">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and blog != blank -%}
        <a href="{{ blog.url }}" class="button button--outline button--small">{{ 'sections.blog.read_more' | t }}</a>
      {%- endif -%}
    </div>

    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));">
      {%- for article in blog.articles limit: section.settings.posts_to_show -%}
        <article class="article-card" data-animate>
          {%- if article.image -%}
            <a href="{{ article.url }}" class="media media--landscape" tabindex="-1" aria-hidden="true">
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.image.alt }}
            </a>
          {%- endif -%}
          <div style="margin-top: 1rem;">
            <p class="article-card__meta">{{ article.published_at | date: format: 'date' }}</p>
            <h3 class="article-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            {%- if section.settings.show_excerpt -%}
              <p class="text-sm">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="article-card">
            <div class="media media--landscape">{{ 'blog-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div style="margin-top: 1rem;">
              <h3 class="article-card__title">{{ 'onboarding.article_title' | t }}</h3>
              <p class="text-sm">{{ 'onboarding.article_excerpt' | t }}</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.blog-posts.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.blog-posts.settings.heading.label",
      "default": "Journal"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.blog-posts.settings.heading_size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.blog-posts.settings.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.blog-posts.settings.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.blog-posts.settings.heading_size.options__3.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog-posts.settings.blog.label",
      "default": "news"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:sections.blog-posts.settings.posts_to_show.label",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog-posts.settings.show_excerpt.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.blog-posts.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.blog-posts.settings.color_scheme.label",
      "default": "scheme_1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog-posts.presets.preset__1.name"
    }
  ]
}
{% endschema %}
