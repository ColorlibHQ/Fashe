<section class="section">
  <div class="page-width customer customer--wide">
    <h1 class="h2">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="text-sm">{{ 'customer.order.date_html' | t: date: order.created_at | date: format: 'date' }}</p>

    {%- if order.cancelled -%}
      <p class="form__message form__message--error">
        {{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | date: format: 'date' }}
        {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
      </p>
    {%- endif -%}

    <table style="margin-top: var(--space-lg);">
      <thead>
        <tr>
          <th>{{ 'customer.order.product' | t }}</th>
          <th>{{ 'customer.order.price' | t }}</th>
          <th>{{ 'customer.order.quantity' | t }}</th>
          <th>{{ 'customer.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>
              <a href="{{ line_item.product.url }}">{{ line_item.title }}</a>
              {%- if line_item.sku != blank %}<br><span class="text-xs">{{ 'customer.order.sku' | t }}: {{ line_item.sku }}</span>{% endif -%}
            </td>
            <td>{{ line_item.price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.quantity | times: line_item.price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3">{{ 'customer.order.subtotal' | t }}</td>
          <td>{{ order.subtotal_price | money }}</td>
        </tr>
        {%- for shipping_method in order.shipping_methods -%}
          <tr>
            <td colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</td>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <tr>
            <td colspan="3">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</td>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {%- endfor -%}
        <tr>
          <td colspan="3"><strong>{{ 'customer.order.total' | t }}</strong></td>
          <td><strong>{{ order.total_price | money_with_currency }}</strong></td>
        </tr>
      </tfoot>
    </table>

    <div class="customer__grid customer__grid--two" style="margin-top: var(--space-lg);">
      <div>
        <h2 class="h5">{{ 'customer.order.billing_address' | t }}</h2>
        <p class="text-sm">{{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </div>
      <div>
        <h2 class="h5">{{ 'customer.order.shipping_address' | t }}</h2>
        <p class="text-sm">{{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}</p>
        {{ order.shipping_address | format_address }}
      </div>
    </div>

    <p style="margin-top: var(--space-lg);">
      <a href="{{ routes.account_url }}" class="button--link">{{ 'customer.account.return' | t }}</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-order.name",
  "tag": "div",
  "settings": []
}
{% endschema %}
