{%- liquid
  assign content = block.settings.content
  if block.settings.page != blank
    assign content = block.settings.page.content
  endif
-%}
<details class="product__accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
  <summary>
    {{ block.settings.heading | escape }}
    {% render 'icon', name: 'chevron-down' %}
  </summary>
  <div class="rte">{{ content }}</div>
</details>

{% schema %}
{
  "name": "t:blocks.accordion.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.accordion.settings.heading.label",
      "default": "Shipping and returns"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:blocks.accordion.settings.content.label",
      "default": "<p>Add details about delivery times and your returns policy.</p>"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:blocks.accordion.settings.page.label",
      "info": "t:blocks.accordion.settings.page.info"
    },
    {
      "type": "checkbox",
      "id": "open",
      "label": "t:blocks.accordion.settings.open.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:blocks.accordion.presets.preset__1.name"
    }
  ]
}
{% endschema %}
