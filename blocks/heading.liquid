<h2 class="{{ block.settings.size }}" style="text-align: {{ block.settings.alignment }};" {{ block.shopify_attributes }}>
  {{ block.settings.heading | escape }}
</h2>

{% schema %}
{
  "name": "t:blocks.heading.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.heading.settings.heading.label",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:blocks.heading.settings.size.label",
      "options": [
        {
          "value": "h3",
          "label": "t:blocks.heading.settings.size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:blocks.heading.settings.size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:blocks.heading.settings.size.options__3.label"
        },
        {
          "value": "h0",
          "label": "t:blocks.heading.settings.size.options__4.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:blocks.heading.settings.alignment.label",
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.heading.presets.preset__1.name"
    }
  ]
}
{% endschema %}
