    {{ product.description }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.description.name",
  "settings": [],
  "presets": [
    {
      "name": "t:blocks.description.presets.preset__1.name"
    }
  ]
}
{% endschema %}
