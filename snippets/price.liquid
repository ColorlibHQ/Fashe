{%- comment -%}
  Usage: {% render 'price', product: product, use_variant: true, class: 'price--large' %}
{%- endcomment -%}
{%- liquid
  if use_variant and product.selected_or_first_available_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at = target.compare_at_price
  assign price = target.price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif
-%}
<div class="price {{ class }}{% if on_sale %} price--on-sale{% endif %}">
  {%- if product.price_varies and use_variant != true -%}
    <span class="visually-hidden">{{ 'products.product.price_from' | t }}</span>
    <span>{{ 'products.product.price_from' | t }} {{ product.price_min | money }}</span>
  {%- else -%}
    <span class="{% if on_sale %}price__sale{% endif %}">{{ price | money }}</span>
    {%- if on_sale -%}
      <s class="price__compare">{{ compare_at | money }}</s>
    {%- endif -%}
  {%- endif -%}

  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{ target.unit_price | money }}
      {{ 'general.accessibility.unit_price_separator' | t }}
      {%- if target.unit_price_measurement.reference_value != 1 %}
        {{- target.unit_price_measurement.reference_value }}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
