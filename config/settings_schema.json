[
  {
    "name": "theme_info",
    "theme_name": "Fashe",
    "theme_version": "2.0.0",
    "theme_author": "Colorlib",
    "theme_documentation_url": "https://colorlib.com/wp/themes/fashe-free-shopify-ecommerce-theme/",
    "theme_support_url": "https://colorlib.com/wp/support/"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#ffffff"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Background gradient",
            "info": "Replaces the background colour when set."
          },
          {
            "type": "color",
            "id": "text",
            "label": "Text",
            "default": "#141414"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Solid button background",
            "default": "#141414"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Solid button label",
            "default": "#ffffff"
          },
          {
            "type": "color",
            "id": "outline_button",
            "label": "Outline button",
            "default": "#141414"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#c8553d"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Borders and rules",
            "default": "#e4e4e4"
          }
        ],
        "role": {
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "text": "text",
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "outline_button",
          "secondary_button_border": "outline_button",
          "shadow": "border"
        }
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Font",
        "default": "assistant_n4"
      },
      {
        "type": "select",
        "id": "heading_case",
        "label": "Letter case",
        "options": [
          { "value": "none", "label": "Default" },
          { "value": "uppercase", "label": "Uppercase" }
        ],
        "default": "none"
      },
      {
        "type": "range",
        "id": "heading_tracking",
        "min": -4,
        "max": 8,
        "step": 1,
        "unit": "%",
        "label": "Letter spacing",
        "default": -2
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Size",
        "default": 100
      },
      {
        "type": "header",
        "content": "Body"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Size",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1800,
        "step": 40,
        "unit": "px",
        "label": "Page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Space between sections",
        "default": 0,
        "info": "Sections also carry their own top and bottom padding."
      },
      {
        "type": "header",
        "content": "Corners"
      },
      {
        "type": "range",
        "id": "radius_base",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Inputs and buttons",
        "default": 0
      },
      {
        "type": "range",
        "id": "radius_media",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Images and cards",
        "default": 0
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image ratio",
        "options": [
          { "value": "adapt", "label": "Adapt to image" },
          { "value": "square", "label": "Square (1:1)" },
          { "value": "portrait", "label": "Portrait (3:4)" },
          { "value": "tall", "label": "Tall (2:3)" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show product rating",
        "default": false,
        "info": "Uses the product's rating metafield."
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Show quick add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "Show colour swatches",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_notes",
        "label": "Enable order notes",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "cart_show_free_shipping_bar",
        "label": "Show free shipping progress bar",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": "100",
        "info": "In your store currency, without symbols."
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Enable search suggestions",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "predictive_search_show_price",
        "label": "Show price in suggestions",
        "default": true
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_reveal",
        "label": "Reveal sections on scroll",
        "default": true,
        "info": "Automatically disabled for visitors who prefer reduced motion."
      },
      {
        "type": "checkbox",
        "id": "animations_hover_zoom",
        "label": "Zoom product images on hover",
        "default": true
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 96 x 96 px."
      },
      {
        "type": "header",
        "content": "Social sharing image"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Image",
        "info": "Used when a page has no image of its own. 1200 x 628 px recommended."
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok" },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook" },
      { "type": "text", "id": "social_pinterest_link", "label": "Pinterest" },
      { "type": "text", "id": "social_youtube_link", "label": "YouTube" },
      { "type": "text", "id": "social_x_link", "label": "X" }
    ]
  }
]
